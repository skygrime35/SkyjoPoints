<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg">

    <!-- Header info -->
    <TextView
        android:id="@+id/tv_grid_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grille de Player"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tv_grid_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total : 0 pt | Toucher une carte puis choisir sa valeur"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- 3x4 Grid Table -->
    <TableLayout
        android:id="@+id/grid_table"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_gravity="center"
        android:stretchColumns="0,1,2,3"
        android:layout_marginBottom="16dp">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp">
            <Button android:id="@+id/card_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_0_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_0_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_0_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp">
            <Button android:id="@+id/card_1_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_1_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_1_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_1_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <Button android:id="@+id/card_2_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_2_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_2_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
            <Button android:id="@+id/card_2_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_margin="3dp" android:textSize="18sp" android:textStyle="bold" android:textAllCaps="false"/>
        </TableRow>
    </TableLayout>

    <!-- Keypad for selecting card value -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Keyboard row 1: -2, -1, 0, 1, 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/btn_val_neg2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="-2" android:backgroundTint="@color/card_blue_dark" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_neg1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="-1" android:backgroundTint="@color/card_cyan" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_0" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="0" android:backgroundTint="@color/card_cyan" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="1" android:backgroundTint="@color/card_green" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="2" android:backgroundTint="@color/card_green" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Keyboard row 2: 3, 4, 5, 6, 7 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/btn_val_3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="3" android:backgroundTint="@color/card_green" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_4" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="4" android:backgroundTint="@color/card_green" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_5" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="5" android:backgroundTint="@color/card_yellow" android:textColor="@color/bg" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_6" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="6" android:backgroundTint="@color/card_yellow" android:textColor="@color/bg" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_7" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="7" android:backgroundTint="@color/card_yellow" android:textColor="@color/bg" android:padding="0dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Keyboard row 3: 8, 9, 10, 11, 12 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">
            <Button android:id="@+id/btn_val_8" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="8" android:backgroundTint="@color/card_yellow" android:textColor="@color/bg" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_9" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="9" android:backgroundTint="@color/card_red" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_10" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="10" android:backgroundTint="@color/card_red" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_11" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="11" android:backgroundTint="@color/card_red" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
            <Button android:id="@+id/btn_val_12" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:text="12" android:backgroundTint="@color/card_red" android:textColor="@color/text_primary" android:padding="0dp" android:textSize="14sp"/>
        </LinearLayout>

        <!-- Keyboard row 4: Clear -->
        <Button
            android:id="@+id/btn_val_clear"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="Vider la case"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_card"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:padding="0dp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Bottom confirmation buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_card"
            android:layout_marginEnd="6dp"
            android:padding="10dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_confirm_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:text="Confirmer"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="6dp"
            android:padding="10dp"
            android:textAllCaps="false"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
