<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/themeBg">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_round_entry_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Saisie des scores - Manche X"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?attr/themePrimary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scores des joueurs"
        android:textColor="?attr/themeTextSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Players Input List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/round_players_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic player input rows populated in code -->
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="?attr/themeTextPrimary"
            android:background="@drawable/bg_rounded_button_secondary"
            android:layout_marginEnd="4dp"
            android:padding="12dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_delete_round_edit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Supprimer"
            android:textColor="#FFD32F2F"
            android:background="@drawable/bg_rounded_button_secondary"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_save_round"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/save_round"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_rounded_button_primary"
            android:layout_marginStart="4dp"
            android:padding="12dp"
            android:textAllCaps="false"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
