<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/themeBg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/history_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?attr/themePrimary"
        android:layout_marginBottom="20dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/history_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic history items added in code -->
            <TextView
                android:id="@+id/tv_empty_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_history"
                android:textColor="?attr/themeTextSecondary"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginTop="64dp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_history"
            android:textColor="@color/penalty_double"
            android:background="@drawable/bg_rounded_button_secondary"
            android:layout_marginEnd="8dp"
            android:padding="12dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btn_back_from_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="Retour"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/bg_rounded_button_primary"
            android:layout_marginStart="8dp"
            android:padding="12dp"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
