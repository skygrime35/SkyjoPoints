<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <AutoCompleteTextView
        android:id="@+id/et_player_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/player_name_hint"
        android:textColor="?attr/themeTextPrimary"
        android:textColorHint="?attr/themeTextSecondary"
        android:background="@drawable/bg_input_field"
        android:inputType="textPersonName"
        android:padding="12dp"
        android:textSize="16sp"
        android:layout_marginEnd="8dp"
        android:completionThreshold="1" />

    <ImageButton
        android:id="@+id/btn_delete_player"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:contentDescription="Supprimer le joueur"
        android:tint="@color/penalty_double" />
</LinearLayout>
